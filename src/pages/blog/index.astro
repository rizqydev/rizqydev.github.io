---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const allCategories = Array.from(
	new Set(posts.flatMap((post) => post.data.categories || ['general']))
).sort();

const categoryCounts: Record<string, number> = {};
posts.forEach((post) => {
	const cats = post.data.categories || ['general'];
	cats.forEach((c) => {
		categoryCounts[c] = (categoryCounts[c] || 0) + 1;
	});
});
---

<Layout title="Blog" description="All my blog posts in one place.">
	<section class="mb-10">
		<h1 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 mb-2">
			Blog
		</h1>
		<p class="text-base text-zinc-600 dark:text-zinc-400 mb-6">
			All my blog posts in one place.
		</p>

		<div class="flex flex-wrap gap-2">
			<button class="cat-pill px-3.5 py-1.5 rounded-full text-xs font-medium bg-zinc-900 text-zinc-50 dark:bg-zinc-100 dark:text-zinc-900 transition cursor-pointer" data-cat="all">
				All ({posts.length})
			</button>
			{
				allCategories.map((cat) => (
					<button class="cat-pill px-3.5 py-1.5 rounded-full text-xs font-medium bg-zinc-100 text-zinc-600 hover:bg-zinc-200 dark:bg-zinc-800 dark:text-zinc-400 dark:hover:bg-zinc-700 transition cursor-pointer" data-cat={cat}>
						{cat} ({categoryCounts[cat]})
					</button>
				))
			}
		</div>
	</section>

	<section class="border-t border-zinc-100 dark:border-zinc-800">
		<div id="posts-container">
			{
				posts.map((post) => {
					const cats = post.data.categories || ['general'];
					return (
						<a
							href={`/blog/${post.id}`}
							data-categories={JSON.stringify(cats)}
							class="post-row group flex items-center justify-between py-4 border-b border-zinc-100 dark:border-zinc-800 hover:border-zinc-300 dark:hover:border-zinc-700 transition-colors"
						>
							<span class="text-base font-medium text-zinc-900 group-hover:text-zinc-600 dark:text-zinc-200 dark:group-hover:text-zinc-400 transition-colors">
								{post.data.title}
							</span>
							<span class="text-sm text-zinc-400 dark:text-zinc-500 shrink-0 ml-4">
								{post.data.pubDate.toLocaleDateString('en-US', {
									month: 'short',
									day: 'numeric',
									year: 'numeric',
								})}
							</span>
						</a>
					);
				})
			}
		</div>

		<div class="mt-8 flex items-center justify-between text-sm text-zinc-500 dark:text-zinc-400">
			<button id="prev-btn" type="button" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition cursor-pointer">← Previous</button>
			<span id="page-info">Page 1 of 2</span>
			<button id="next-btn" type="button" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition cursor-pointer">Next →</button>
		</div>
	</section>

	<script is:inline>
		document.addEventListener('DOMContentLoaded', () => {
			const pills = document.querySelectorAll('.cat-pill');
			const rows = Array.from(document.querySelectorAll('.post-row'));
			const prevBtn = document.getElementById('prev-btn');
			const nextBtn = document.getElementById('next-btn');
			const pageInfo = document.getElementById('page-info');

			let currentPage = 1;
			let currentCat = 'all';
			const perPage = 5;

			function updateDisplay() {
				const matchingRows = rows.filter((row) => {
					const cats = JSON.parse(row.getAttribute('data-categories') || '[]');
					return currentCat === 'all' || cats.includes(currentCat);
				});

				const totalPages = Math.max(1, Math.ceil(matchingRows.length / perPage));
				if (currentPage > totalPages) currentPage = totalPages;
				if (currentPage < 1) currentPage = 1;

				const startIndex = (currentPage - 1) * perPage;
				const endIndex = startIndex + perPage;
				const visibleSet = new Set(matchingRows.slice(startIndex, endIndex));

				rows.forEach((row) => {
					if (visibleSet.has(row)) {
						row.style.display = 'flex';
					} else {
						row.style.display = 'none';
					}
				});

				pageInfo.textContent = `Page ${currentPage} of ${totalPages}`;

				if (currentPage <= 1) {
					prevBtn.style.opacity = '0.3';
					prevBtn.style.pointerEvents = 'none';
				} else {
					prevBtn.style.opacity = '1';
					prevBtn.style.pointerEvents = 'auto';
				}

				if (currentPage >= totalPages) {
					nextBtn.style.opacity = '0.3';
					nextBtn.style.pointerEvents = 'none';
				} else {
					nextBtn.style.opacity = '1';
					nextBtn.style.pointerEvents = 'auto';
				}
			}

			pills.forEach((pill) => {
				pill.addEventListener('click', () => {
					currentCat = pill.getAttribute('data-cat');
					currentPage = 1;

					pills.forEach((p) => {
						p.className = "cat-pill px-3.5 py-1.5 rounded-full text-xs font-medium bg-zinc-100 text-zinc-600 hover:bg-zinc-200 dark:bg-zinc-800 dark:text-zinc-400 dark:hover:bg-zinc-700 transition cursor-pointer";
					});
					pill.className = "cat-pill px-3.5 py-1.5 rounded-full text-xs font-medium bg-zinc-900 text-zinc-50 dark:bg-zinc-100 dark:text-zinc-900 transition cursor-pointer";

					updateDisplay();
				});
			});

			prevBtn.addEventListener('click', () => {
				if (currentPage > 1) {
					currentPage--;
					updateDisplay();
				}
			});

			nextBtn.addEventListener('click', () => {
				currentPage++;
				updateDisplay();
			});

			updateDisplay();
		});
	</script>
</Layout>
