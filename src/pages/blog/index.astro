---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BlogLayout title="Blog - My Blog" description="All blog posts">
	<section class="py-8">
		<h1 class="text-4xl font-bold text-gray-900 mb-4">Blog</h1>
		<p class="text-xl text-gray-600 mb-12">All my blog posts in one place.</p>

		<div class="space-y-6">
			{posts.map((post) => (
				<article class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:shadow-md transition">
					<a href={`/blog/${post.id}`} class="block p-6">
						<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
							<div class="flex-1">
								<div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
									<time datetime={post.data.pubDate.toISOString()}>
										{post.data.pubDate.toLocaleDateString('en-US', {
											year: 'numeric',
											month: 'long',
											day: 'numeric',
										})}
									</time>
								</div>
								<h2 class="text-xl font-bold text-gray-900 mb-2 hover:text-indigo-600 transition">
									{post.data.title}
								</h2>
								<p class="text-gray-600">{post.data.description}</p>
							</div>
						</div>
					</a>
				</article>
			))}
		</div>

		{posts.length === 0 && (
			<p class="text-center text-gray-600 py-16">No posts yet. Check back soon!</p>
		)}
	</section>
</BlogLayout>