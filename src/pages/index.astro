---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 5);
---

<Layout>
	<section class="mb-14">
		<h1 class="text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 mb-4">
			Hi, I'm Rizqy
		</h1>
		<p class="text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">
			I'm a fullstack web developer with 5+ years of experience building with PHP, JavaScript, and Go. I love turning ideas into practical solutions and learning new tools along the way.
		</p>
		<a href="/about" class="inline-block mt-4 text-zinc-900 hover:text-zinc-700 font-medium transition dark:text-zinc-400 dark:hover:text-zinc-300">
			More about me &rarr;
		</a>
	</section>

	<section>
		<div class="text-xs font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 mb-4">
			Recent Blog
		</div>
		<div class="border-t border-zinc-100 dark:border-zinc-800">
			{
				posts.map((post) => (
					<a
						href={`/blog/${post.id}`}
						class="group flex items-center justify-between py-4 border-b border-zinc-100 dark:border-zinc-800 hover:border-zinc-300 dark:hover:border-zinc-700 transition-colors"
					>
						<span class="text-base font-medium text-zinc-900 group-hover:text-zinc-600 dark:text-zinc-200 dark:group-hover:text-zinc-400 transition-colors">
							{post.data.title}
						</span>
						<span class="text-sm text-zinc-400 dark:text-zinc-500 shrink-0 ml-4">
							{post.data.pubDate.toLocaleDateString('en-US', {
								month: 'short',
								day: 'numeric',
								year: 'numeric',
							})}
						</span>
					</a>
				))
			}
		</div>
	</section>
</Layout>
