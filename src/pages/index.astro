---
import BlogLayout from '../layouts/BlogLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const latestPost = posts[0];
const otherPosts = posts.slice(1);
---

<BlogLayout title="My Blog - Home" description="Welcome to my blog about web development">
	<!-- Hero Section -->
	<section class="text-center py-16">
		<h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4 dark:text-gray-100">
			Welcome to My Blog
		</h1>
		<p class="text-xl text-gray-600 max-w-2xl mx-auto dark:text-gray-300">
			Sharing my thoughts on web development, coding, and technology.
		</p>
	</section>

	<!-- Latest Post -->
	{latestPost && (
		<section class="mb-12">
			<h2 class="text-2xl font-semibold text-gray-900 mb-6 dark:text-gray-100">Latest Post</h2>
			<article class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:shadow-md transition dark:bg-gray-800 dark:border-gray-700">
				<a href={`/blog/${latestPost.id}`} class="block">
					<div class="aspect-video bg-linear-to-br from-indigo-500 to-purple-600 flex items-center justify-center">
						<span class="text-white text-6xl opacity-50">📝</span>
					</div>
					<div class="p-6">
						<div class="flex items-center gap-2 text-sm text-gray-500 mb-2 dark:text-gray-400">
							<time datetime={latestPost.data.pubDate.toISOString()}>
								{latestPost.data.pubDate.toLocaleDateString('en-US', {
									year: 'numeric',
									month: 'long',
									day: 'numeric',
								})}
							</time>
						</div>
						<h3 class="text-2xl font-bold text-gray-900 mb-2 hover:text-indigo-600 transition dark:text-gray-100">
							{latestPost.data.title}
						</h3>
						<p class="text-gray-600 dark:text-gray-300">{latestPost.data.description}</p>
					</div>
				</a>
			</article>
		</section>
	)}

	<!-- Other Posts -->
	{otherPosts.length > 0 && (
		<section>
			<h2 class="text-2xl font-semibold text-gray-900 mb-6 dark:text-gray-100">Recent Posts</h2>
			<div class="grid md:grid-cols-2 gap-6">
				{otherPosts.map((post) => (
					<article class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:shadow-md transition dark:bg-gray-800 dark:border-gray-700">
						<a href={`/blog/${post.id}`} class="block p-6">
							<div class="flex items-center gap-2 text-sm text-gray-500 mb-2 dark:text-gray-400">
								<time datetime={post.data.pubDate.toISOString()}>
									{post.data.pubDate.toLocaleDateString('en-US', {
										year: 'numeric',
										month: 'long',
										day: 'numeric',
									})}
								</time>
							</div>
							<h3 class="text-xl font-bold text-gray-900 mb-2 hover:text-indigo-600 transition dark:text-gray-100">
								{post.data.title}
							</h3>
							<p class="text-gray-600 dark:text-gray-300">{post.data.description}</p>
						</a>
					</article>
				))}
			</div>
		</section>
	)}

	<!-- No Posts -->
	{posts.length === 0 && (
		<p class="text-center text-gray-600 py-16 dark:text-gray-300">No posts yet. Check back soon!</p>
	)}
</BlogLayout>