---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { title = "Rizqy's Blog", description = "Software developer writing notes on TypeScript, Postgres, and web tooling." } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline>
			(function () {
				const stored = localStorage.getItem('theme');
				const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				if (stored === 'dark' || (!stored && prefersDark)) {
					document.documentElement.classList.add('dark');
				}
			})();
		</script>
	</head>
	<body class="bg-white text-zinc-900 min-h-screen flex flex-col antialiased selection:bg-zinc-200 dark:bg-[#09090B] dark:text-zinc-100 dark:selection:bg-zinc-800 font-sans">
		<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-zinc-100 dark:bg-[#09090B]/90 dark:border-zinc-800">
			<div class="max-w-[720px] mx-auto px-6 h-18 flex justify-between items-center">
				<a href="/" class="text-[17px] font-bold tracking-tight text-zinc-900 hover:text-zinc-600 transition dark:text-zinc-100 dark:hover:text-zinc-300">
					Rizqy's Blog
				</a>
				<div class="flex items-center gap-7">
					<nav class="flex items-center gap-7 text-sm">
						<a href="/blog" data-nav="blog" class="nav-link text-zinc-600 hover:text-zinc-900 transition dark:text-zinc-400 dark:hover:text-zinc-100">Blog</a>
						<a href="/about" data-nav="about" class="nav-link text-zinc-600 hover:text-zinc-900 transition dark:text-zinc-400 dark:hover:text-zinc-100">About</a>
					</nav>
					<button
						id="theme-toggle"
						type="button"
						aria-label="Toggle theme"
						class="w-9 h-9 rounded-full flex items-center justify-center border border-zinc-200 text-zinc-700 hover:bg-zinc-50 transition dark:border-zinc-800 dark:text-zinc-300 dark:hover:bg-zinc-900/60"
					>
						<svg class="w-4 h-4 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
						<svg class="w-4 h-4 block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
					</button>
				</div>
			</div>
		</header>

		<main class="w-full max-w-[720px] mx-auto px-6 py-12 flex-1">
			<slot />
		</main>

		<footer class="w-full max-w-[720px] mx-auto px-6 py-8 border-t border-zinc-100 dark:border-zinc-900 flex flex-col sm:flex-row justify-between items-center text-xs text-zinc-400 dark:text-zinc-500">
			<div>&copy; {new Date().getFullYear()} Rizqy &middot; Built with Astro</div>
			<div class="flex gap-4 mt-2 sm:mt-0">
				<a href="https://github.com" target="_blank" rel="noreferrer" class="hover:text-zinc-900 dark:hover:text-zinc-300 transition">GitHub</a>
				<a href="https://twitter.com" target="_blank" rel="noreferrer" class="hover:text-zinc-900 dark:hover:text-zinc-300 transition">Twitter</a>
				<a href="/rss.xml" class="hover:text-zinc-900 dark:hover:text-zinc-300 transition">RSS</a>
			</div>
		</footer>

		<script is:inline>
			(function () {
				const path = window.location.pathname.replace(/\/+$/, '') || '/';
				const links = document.querySelectorAll('a.nav-link[data-nav]');
				links.forEach((el) => {
					const key = el.getAttribute('data-nav');
					const isBlog = key === 'blog' && (path === '/blog' || path.startsWith('/blog/'));
					const isAbout = key === 'about' && (path === '/about' || path.startsWith('/about/'));
					if (isBlog || isAbout) {
						el.classList.add('font-semibold', 'text-zinc-900', 'dark:text-zinc-100');
						el.classList.remove('text-zinc-600', 'dark:text-zinc-400');
					}
				});

				const toggle = document.getElementById('theme-toggle');
				const updateTheme = () => {
					const isDark = document.documentElement.classList.toggle('dark');
					localStorage.setItem('theme', isDark ? 'dark' : 'light');
				};
				if (toggle) toggle.addEventListener('click', updateTheme);
			})();
		</script>
	</body>
</html>
