---
import '../styles/global.css';
import { getCollection } from 'astro:content';

interface Props {
	title?: string;
	description?: string;
}

const { title = "Rizqy's Blog", description = "Software developer writing notes on TypeScript, Postgres, and web tooling." } = Astro.props;

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// ponytail: in-memory search index for modal. Max ~100 posts ceiling before switching to Pagefind.
const searchIndex = posts.map((p) => ({
	id: p.id,
	title: p.data.title,
	description: p.data.description,
	date: p.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }),
	categories: p.data.categories || ['general'],
	body: p.body || ''
}));
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline>
			(function () {
				const stored = localStorage.getItem('theme');
				const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				if (stored === 'dark' || (!stored && prefersDark)) {
					document.documentElement.classList.add('dark');
				}
			})();
		</script>
	</head>
	<body class="bg-white text-zinc-900 min-h-screen flex flex-col antialiased selection:bg-zinc-200 dark:bg-[#09090B] dark:text-zinc-100 dark:selection:bg-zinc-800 font-sans">
		<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-zinc-100 dark:bg-[#09090B]/90 dark:border-zinc-800">
			<div class="max-w-[720px] mx-auto px-6 h-18 flex justify-between items-center">
				<a href="/" class="text-[17px] font-bold tracking-tight text-zinc-900 hover:text-zinc-600 transition dark:text-zinc-100 dark:hover:text-zinc-300">
					Rizqy's Blog
				</a>
				<div class="flex items-center gap-7">
					<nav class="flex items-center gap-7 text-sm">
						<a href="/blog" data-nav="blog" class="nav-link text-zinc-600 hover:text-zinc-900 transition dark:text-zinc-400 dark:hover:text-zinc-100">Blog</a>
						<a href="/about" data-nav="about" class="nav-link text-zinc-600 hover:text-zinc-900 transition dark:text-zinc-400 dark:hover:text-zinc-100">About</a>
					</nav>
					<div class="flex items-center gap-2">
						<button
							id="search-toggle"
							type="button"
							aria-label="Search posts (Ctrl+K)"
							class="w-9 h-9 rounded-full flex items-center justify-center border border-zinc-200 text-zinc-700 hover:bg-zinc-50 transition dark:border-zinc-800 dark:text-zinc-300 dark:hover:bg-zinc-900/60 cursor-pointer"
						>
							<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="11" cy="11" r="8"></circle>
								<path d="m21 21-4.3-4.3"></path>
							</svg>
						</button>
						<button
							id="theme-toggle"
							type="button"
							aria-label="Toggle theme"
							class="w-9 h-9 rounded-full flex items-center justify-center border border-zinc-200 text-zinc-700 hover:bg-zinc-50 transition dark:border-zinc-800 dark:text-zinc-300 dark:hover:bg-zinc-900/60 cursor-pointer"
						>
							<svg class="w-4 h-4 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
							<svg class="w-4 h-4 block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
						</button>
					</div>
				</div>
			</div>
		</header>

		<main class="w-full max-w-[720px] mx-auto px-6 py-12 flex-1">
			<slot />
		</main>

		<footer class="w-full max-w-[720px] mx-auto px-6 py-8 border-t border-zinc-100 dark:border-zinc-900 flex flex-col sm:flex-row justify-between items-center text-xs text-zinc-400 dark:text-zinc-500">
			<div>&copy; {new Date().getFullYear()} Rizqy &middot; Built with Astro</div>
			<div class="flex gap-4 mt-2 sm:mt-0">
				<a href="https://github.com" target="_blank" rel="noreferrer" class="hover:text-zinc-900 dark:hover:text-zinc-300 transition">GitHub</a>
				<a href="https://twitter.com" target="_blank" rel="noreferrer" class="hover:text-zinc-900 dark:hover:text-zinc-300 transition">Twitter</a>
				<a href="/rss.xml" class="hover:text-zinc-900 dark:hover:text-zinc-300 transition">RSS</a>
			</div>
		</footer>

		<dialog
			id="search-dialog"
			class="fixed top-12 sm:top-20 inset-x-0 mx-auto w-[92vw] max-w-[560px] p-0 rounded-xl bg-white text-zinc-900 border border-zinc-200 shadow-2xl dark:bg-[#121215] dark:text-zinc-100 dark:border-zinc-800 backdrop:bg-black/50 backdrop:backdrop-blur-xs outline-none overflow-hidden"
		>
			<div class="flex items-center px-4 border-b border-zinc-100 dark:border-zinc-800">
				<svg class="w-4 h-4 text-zinc-400 dark:text-zinc-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="11" cy="11" r="8"></circle>
					<path d="m21 21-4.3-4.3"></path>
				</svg>
				<input
					type="text"
					id="search-input"
					placeholder="Search posts..."
					class="w-full bg-transparent px-3 py-3.5 text-sm text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 dark:placeholder-zinc-500 focus:outline-none"
					autocomplete="off"
				/>
				<kbd class="hidden sm:inline-block px-1.5 py-0.5 text-[10px] font-mono text-zinc-400 dark:text-zinc-500 border border-zinc-200 dark:border-zinc-700 rounded">ESC</kbd>
			</div>

			<div id="search-results" class="max-h-[60vh] overflow-y-auto p-2 space-y-1">
				<p class="py-8 text-xs text-zinc-400 dark:text-zinc-500 text-center">Type to start searching...</p>
			</div>

			<div class="px-4 py-2 border-t border-zinc-100 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/50 flex justify-between items-center text-[11px] text-zinc-400 dark:text-zinc-500">
				<span class="truncate">Search title, content, or tags</span>
				<div class="hidden sm:flex items-center gap-3 shrink-0">
					<span><kbd class="font-mono">↑↓</kbd> navigate</span>
					<span><kbd class="font-mono">↵</kbd> select</span>
					<span><kbd class="font-mono">esc</kbd> close</span>
				</div>
			</div>
		</dialog>

		<script define:vars={{ searchIndex }}>
			(function () {
				const path = window.location.pathname.replace(/\/+$/, '') || '/';
				const links = document.querySelectorAll('a.nav-link[data-nav]');
				links.forEach((el) => {
					const key = el.getAttribute('data-nav');
					const isBlog = key === 'blog' && (path === '/blog' || path.startsWith('/blog/'));
					const isAbout = key === 'about' && (path === '/about' || path.startsWith('/about/'));
					if (isBlog || isAbout) {
						el.classList.add('font-semibold', 'text-zinc-900', 'dark:text-zinc-100');
						el.classList.remove('text-zinc-600', 'dark:text-zinc-400');
					}
				});

				const toggle = document.getElementById('theme-toggle');
				const updateTheme = () => {
					const isDark = document.documentElement.classList.toggle('dark');
					localStorage.setItem('theme', isDark ? 'dark' : 'light');
				};
				if (toggle) toggle.addEventListener('click', updateTheme);

				const dialog = document.getElementById('search-dialog');
				const searchToggle = document.getElementById('search-toggle');
				const input = document.getElementById('search-input');
				const results = document.getElementById('search-results');

				let currentMatches = [];
				let activeIndex = -1;

				function renderResults() {
					if (!input.value.trim()) {
						results.innerHTML = '<p class="py-8 text-xs text-zinc-400 dark:text-zinc-500 text-center">Type to start searching...</p>';
						return;
					}
					if (currentMatches.length === 0) {
						results.innerHTML = '<p class="py-8 text-xs text-zinc-400 dark:text-zinc-500 text-center">No posts found</p>';
						return;
					}

					results.innerHTML = currentMatches
						.map((post, i) => {
							const isActive = i === activeIndex;
							return `
								<a
									href="/blog/${post.id}"
									class="block p-3 rounded-lg transition ${
										isActive
											? 'bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100'
											: 'hover:bg-zinc-50 dark:hover:bg-zinc-800/50 text-zinc-700 dark:text-zinc-300'
									}"
								>
									<div class="flex justify-between items-baseline mb-1">
										<span class="text-sm font-medium ${isActive ? 'text-zinc-900 dark:text-zinc-50' : ''}">${post.title}</span>
										<span class="text-[11px] text-zinc-400 dark:text-zinc-500 ml-2 shrink-0">${post.date}</span>
									</div>
									<p class="text-xs text-zinc-500 dark:text-zinc-400 line-clamp-1">${post.description}</p>
								</a>
							`;
						})
						.join('');
				}

				function openModal() {
					if (!dialog.open) {
						dialog.showModal();
						input.value = '';
						currentMatches = [];
						activeIndex = -1;
						renderResults();
						input.focus();
					}
				}

				if (searchToggle) searchToggle.addEventListener('click', openModal);

				dialog.addEventListener('click', (e) => {
					if (e.target === dialog) dialog.close();
				});

				window.addEventListener('keydown', (e) => {
					if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
						e.preventDefault();
						dialog.open ? dialog.close() : openModal();
					}
				});

				input.addEventListener('input', (e) => {
					const q = e.target.value.toLowerCase().trim();
					if (!q) {
						currentMatches = [];
						activeIndex = -1;
					} else {
						currentMatches = searchIndex.filter(
							(p) =>
								p.title.toLowerCase().includes(q) ||
								p.description.toLowerCase().includes(q) ||
								p.body.toLowerCase().includes(q) ||
								p.categories.some((c) => c.toLowerCase().includes(q))
						);
						activeIndex = currentMatches.length > 0 ? 0 : -1;
					}
					renderResults();
				});

				input.addEventListener('keydown', (e) => {
					if (e.key === 'ArrowDown') {
						e.preventDefault();
						if (currentMatches.length > 0) {
							activeIndex = (activeIndex + 1) % currentMatches.length;
							renderResults();
						}
					} else if (e.key === 'ArrowUp') {
						e.preventDefault();
						if (currentMatches.length > 0) {
							activeIndex = (activeIndex - 1 + currentMatches.length) % currentMatches.length;
							renderResults();
						}
					} else if (e.key === 'Enter') {
						e.preventDefault();
						if (activeIndex >= 0 && currentMatches[activeIndex]) {
							window.location.href = `/blog/${currentMatches[activeIndex].id}`;
						}
					}
				});
			})();
		</script>
	</body>
</html>
